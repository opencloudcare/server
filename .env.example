# Server port
PORT=8080

# Public base URL of the server (used by Better Auth for redirects)
BETTER_AUTH_URL=http://localhost:8080

# Random secret for signing sessions — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# MinIO / S3 storage
S3_URL=http://localhost:9000
ACCESS_KEY=minioadmin
SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=opencarebucket

# Google Gemini API key — https://aistudio.google.com/app/apikey
LLM_API_KEY=

# Hugging Face API key (used for embeddings) — https://huggingface.co/settings/tokens
HF_API_KEY=

# Tavily web search API key — https://app.tavily.com
TAVILY_API_KEY=

# URL and shared secret for the python-server redaction microservice
EXTERNAL_SERVER_URL=http://localhost:5000
EXTERNAL_SERVER_KEY=

# 32-byte hex key for encrypting sensitive stored data — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
